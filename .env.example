# ==============================================================================
# Assessify Environment Configuration Template
# Copy this file to .env and configure values before starting services
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=student1
POSTGRES_DB=postgres

# Redis Configuration (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Discovery (Netflix Eureka)
EUREKA_SERVER_URL=http://localhost:8761/eureka

# Gateway & Ports
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
QUIZ_SERVICE_PORT=8082
QUESTION_SERVICE_PORT=8083
RESULT_SERVICE_PORT=8084

# Security: JWT & RSA Keypair (Override in production via AWS Secrets Manager)
JWT_EXPIRATION_MS=86400000

# AWS Infrastructure Deployment (Terraform)
AWS_REGION=us-east-1
AWS_ENVIRONMENT=prod
